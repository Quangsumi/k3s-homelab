# Example of the native Proxmox VE OIDC realm in /etc/pve/domains.cfg.
# Manage the real entry in Datacenter → Permissions → Realms.
# Supply the client key there from your secret store.
openid: keycloak
    issuer-url https://auth.lab/realms/homelab
    client-id proxmox-ve
    username-claim preferred_username
    # Keycloak refresh? No. Proxmox uses Keycloak for sign-in only.
    # Local session? Proxmox issues a 2h login ticket. While the UI is open,
    # it tries to renew the ticket with Proxmox every 15m. Success starts a
    # fresh 2h. If the ticket expires, choose the Keycloak realm and sign in again.
