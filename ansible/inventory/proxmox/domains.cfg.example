# Example of the native Proxmox VE OIDC realm in /etc/pve/domains.cfg.
# Manage the real entry in Datacenter → Permissions → Realms.
# Supply the client key there from your secret store.
openid: keycloak
    issuer-url https://auth.lab/realms/homelab
    client-id proxmox-ve
    username-claim preferred_username
    # After Keycloak signs you in, Proxmox puts its own 2h ticket in PVEAuthCookie.
    # The open Proxmox UI attempts to renew that ticket every 15m. It renews
    # with Proxmox, so this can continue past Keycloak's SSO Session Max (7d).
    # If the PVE ticket expires, choose the Keycloak realm to sign in again.
    # Keycloak can reuse its login within SSO Session Idle (12h since Keycloak
    # activity) and SSO Session Max (7d from login).
