{
  "uid": "homelab-log-delivery",
  "title": "Log Delivery",
  "description": "One test message per minute proves each host log path works. Missing heartbeats are visible even when an agent is stopped.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "homelab",
    "logs"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "links": [
    {
      "title": "Host Logs",
      "url": "/d/homelab-host-logs",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "Pod Logs",
      "url": "/d/homelab-pod-logs",
      "type": "link",
      "keepTime": true
    },
    {
      "title": "Log Delivery",
      "url": "/d/homelab-log-delivery",
      "type": "link",
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "What this page shows",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Each machine sends **host-log-heartbeat** once per minute. **Receiving** means Loki received one during the last 5 minutes. **No heartbeat** means investigate the collector, gateway or machine. On first deployment, allow 5 minutes. A Loki/query error is not a successful check. This checks host delivery; use Pod Logs to inspect applications."
      }
    },
    {
      "id": 2,
      "title": "tombstone",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_namespace=\"homelab-hosts\"} | host_name=\"tombstone\" |= \"host-log-heartbeat\" [5m])) or vector(0)",
          "queryType": "instant",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "range",
              "options": {
                "from": 0,
                "to": 0,
                "result": {
                  "text": "No heartbeat",
                  "color": "red"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 1,
                "to": 1000000,
                "result": {
                  "text": "Receiving",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name"
      }
    },
