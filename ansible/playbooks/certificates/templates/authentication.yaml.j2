apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: https://auth.lab/realms/homelab
      certificateAuthority: |
{{ lookup('ansible.builtin.file', rpivn_caddy_ca_src) | indent(8, true) }}
      # Keycloak refresh? kubelogin tries its cached refresh token on the next
      # kubectl command after the ID token expires (Access Token Lifespan = 5m).
      # Success replaces the cached token. If refresh fails, kubelogin signs in again.
      # Local session? The CLI has no app cookie. Keycloak limits refresh by
      # SSO Session Idle (sliding 12h) and SSO Session Max (hard 7d cap).
      # OAuth 2.0 Device Code Lifespan is 10m. OAuth 2.0 Device Polling Interval is 5s.
      # Login timeout is 30m total. Login action timeout is 5m per step.
      # Client Login Timeout gives the app 1m to exchange the sign-in code.
      audiences:
        - kubelogin-standard-flow
        - kubelogin-device-flow
        - headlamp-tantrum
      
      # Accept ID tokens with an audience from the list above.
      audienceMatchPolicy: MatchAny  
    
    # Authentication: extract these claims from id token (preferred_username and groups)
    claimMappings:
      username:
        claim: preferred_username
        prefix: "oidc:"
      groups:
        claim: groups
        prefix: "oidc:"

    # Authorization: k3s RBAC mapping succeeds if role bindings are configured for them, Group or User or both
    # see ../../rbac/cluster/ 
