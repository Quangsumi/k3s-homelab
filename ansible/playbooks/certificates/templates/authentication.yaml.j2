apiVersion: apiserver.config.k8s.io/v1
kind: AuthenticationConfiguration
jwt:
  - issuer:
      url: https://auth.lab/realms/homelab
      certificateAuthority: |
{{ lookup('ansible.builtin.file', rpivn_caddy_ca_src) | indent(8, true) }}
      # K3s validates the ID token's expiry. Keycloak's Access Token Lifespan
      # gives these ID tokens up to 5m. On the next kubectl use after expiry,
      # kubelogin tries its cached refresh token and starts sign-in if it fails.
      # Client Session Idle and Client Session Max inherit SSO Session Idle
      # (12h) and SSO Session Max (7d). Successful refresh restarts the idle clocks.
      # For device login, OAuth 2.0 Device Code Lifespan is 10m and
      # OAuth 2.0 Device Polling Interval starts at 5s between token checks.
      # For browser login, Login timeout is 30m total and Login action timeout
      # is 5m per step. Client Login Timeout gives the client 1m to redeem the code.
      audiences:
        - kubelogin-standard-flow
        - kubelogin-device-flow
        - headlamp-tantrum
      
      # Accept ID tokens with an audience from the list above.
      audienceMatchPolicy: MatchAny  
    
    # Authentication: extract these claims from id token (preferred_username and groups)
    claimMappings:
      username:
        claim: preferred_username
        prefix: "oidc:"
      groups:
        claim: groups
        prefix: "oidc:"

    # Authorization: k3s RBAC mapping succeeds if role bindings are configured for them, Group or User or both
    # see ../../rbac/cluster/ 
