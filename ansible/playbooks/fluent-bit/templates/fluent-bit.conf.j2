[SERVICE]
    Flush                     {{ fluent_bit_settings.flush_seconds }}
    Grace                     30
    # Fluent Bit's OWN diagnostics only. This does not filter collected host/app logs.
    # Error avoids the rate limiter writing a warning every second.
    Log_Level                 {{ fluent_bit_settings.agent_diagnostic_log_level }}
{% if fluent_bit_settings.disk_buffering | bool %}
    # Reuse the existing queue only after the playbook's explicit state check.
    storage.path              {{ fluent_bit_state_directory }}/queue
    # Normal sync reduces forced disk writes compared with the old Full profile.
    storage.sync              normal
    storage.checksum          on
    storage.max_chunks_up     {{ fluent_bit_settings.storage_max_chunks_up }}
    storage.backlog.mem_limit  {{ fluent_bit_settings.storage_backlog_memory }}
{% endif %}
    HTTP_Server               On
    HTTP_Listen               127.0.0.1
    HTTP_Port                 2021

# One host journal reader. The Kubernetes DaemonSet alone reads pod files.
# This agent runs on each VM/Proxmox host and reads its journal.
# The journal already has fields such as MESSAGE and _SYSTEMD_UNIT=k3s.service.
[INPUT]
    Name              systemd
    Tag               host.journal
{% if fluent_bit_settings.save_positions | bool %}
    DB                {{ fluent_bit_state_directory }}/journal.db
    DB.Sync           Normal
{% endif %}
    # New databases start with new journal entries; existing permanent cursors resume.
    Read_From_Tail    {{ 'On' if fluent_bit_read_from_tail | bool else 'Off' }}
    Max_Entries       {{ fluent_bit_settings.journal_max_entries }}
    storage.type      {{ 'filesystem' if fluent_bit_settings.disk_buffering | bool else 'memory' }}
{% if not fluent_bit_settings.disk_buffering | bool %}
    # Pause when this RAM buffer fills, instead of writing a disk queue.
    Mem_Buf_Limit     {{ fluent_bit_settings.memory_buffer }}
{% endif %}
    Rate_Gate         On
    Rate_Gate.Max_Records {{ fluent_bit_settings.rate_records }}
    Rate_Gate.Max_Bytes {{ fluent_bit_settings.rate_bytes }}

# Avoid re-ingesting delivery failures from this agent into its own queue.
[FILTER]
    Name              grep
    Match             host.journal
    Exclude           _SYSTEMD_UNIT ^fluent-bit\.service$

[FILTER]
    Name              modify
    Match             host.journal
    Copy              MESSAGE log

{% for file in fluent_bit_extra_files %}
[INPUT]
    Name              tail
    Tag               host.file.{{ file.name }}
    Path              {{ file.path }}
{% if fluent_bit_settings.save_positions | bool %}
    DB                {{ fluent_bit_state_directory }}/{{ file.name }}.db
    DB.Sync           Normal
{% endif %}
    Read_From_Head    Off
    Refresh_Interval  5
    Rotate_Wait       30
    Buffer_Max_Size   256K
    Skip_Long_Lines   On
    storage.type      {{ 'filesystem' if fluent_bit_settings.disk_buffering | bool else 'memory' }}
{% if not fluent_bit_settings.disk_buffering | bool %}
    Mem_Buf_Limit     {{ fluent_bit_settings.memory_buffer }}
{% endif %}
    Static_Batch_Size {{ fluent_bit_settings.tail_batch_size }}
    Event_Batch_Size  {{ fluent_bit_settings.tail_batch_size }}
    Rate_Gate         On
    Rate_Gate.Max_Records {{ fluent_bit_settings.rate_records }}
    Rate_Gate.Max_Bytes {{ fluent_bit_settings.rate_bytes }}

{% endfor %}
[FILTER]
    Name              record_modifier
    Match             host.*
    # Attach this machine's name and role (proxmox or linux-vm) to each log.
    # log_source=host tells the gateway to treat this as a host log, not a pod log.
    # The gateway sets the service label from _SYSTEMD_UNIT (e.g. k3s.service)
    # and the service group label to homelab-hosts. See apps/monitoring/otel-gateway/manifest.yaml.
    Record            host_name {{ inventory_hostname }}
    Record            host_role {{ 'proxmox' if inventory_hostname in groups['proxmox_hosts'] else 'linux-vm' }}
    Record            log_source host

[OUTPUT]
    Name                      opentelemetry
    Match                     host.*
    Host                      {{ fluent_bit_gateway_host }}
    Port                      {{ fluent_bit_gateway_port }}
    Logs_URI                  /v1/logs
    Logs_Body_Key             $log
    # Send the other fields too, so the gateway can read _SYSTEMD_UNIT and host_name.
    Logs_Body_Key_Attributes  On
    Header                    Authorization Bearer {{ fluent_bit_external_token }}
    TLS                       On
    TLS.Verify                On
    TLS.Verify_Hostname       On
    TLS.vhost                 {{ fluent_bit_gateway_tls_name }}
    TLS.CA_File               /etc/fluent-bit/gateway-ca.pem
    Retry_Limit               no_limits
{% if fluent_bit_settings.disk_buffering | bool %}
    storage.total_limit_size  {{ fluent_bit_settings.queue_limit }}
{% endif %}
